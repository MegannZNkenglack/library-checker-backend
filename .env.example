# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Shown publicly on the /privacy page (linked from the Chrome Web Store listing
# and the Google OAuth consent screen) — use a real support address before publishing.
SUPPORT_EMAIL=support@example.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING

# ── NoveList ──────────────────────────────────────────────────────────────────
# Add credentials for each library you support.
# Format: NOVELIST_<SUBDOMAIN>=profile:password
# e.g. for hpl.bibliocommons.com → NOVELIST_HPL=s5726404.main.novsel:dGJyMOPY8Ui2prIA
NOVELIST_HPL=s5726404.main.novsel:dGJyMOPY8Ui2prIA

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client ID
# Application type: Web application
# Authorised redirect URI: https://your-backend.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
# Create a product + price at dashboard.stripe.com → Products
STRIPE_PRICE_ID=price_REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_SUCCESS_URL=https://your-backend.onrender.com/billing/success
STRIPE_CANCEL_URL=https://your-backend.onrender.com/billing/cancel

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Chrome extension ID — find it at chrome://extensions after loading
EXTENSION_ID=REPLACE_WITH_YOUR_EXTENSION_ID

# ── Email (verification codes + availability notifications) ─────────────────
# Gmail SMTP: use a Google "App password" (Account -> Security -> 2-Step Verification -> App passwords).
# Without these (and without RESEND_API_KEY), production signup returns 503; in dev the code is printed to the console.
SMTP_USER=REPLACE_WITH_GMAIL_ADDRESS
SMTP_PASS=REPLACE_WITH_16_CHAR_APP_PASSWORD

# Email verification at signup. Leave false until the extension version with the code-entry screen is live in the Chrome Web Store.
REQUIRE_EMAIL_VERIFICATION=false
